---
import { getCategorySlug, getCategoryName, normalizeCategories } from '../lib/categorySlug';
import { readData } from '../lib/readData';
import { getCollection } from 'astro:content';
import HeadPlugins from '../plugins/_slots/HeadPlugins.astro';
import BodyEndPlugins from '../plugins/_slots/BodyEndPlugins.astro';
import CustomCodeBodyStart from '../plugins/custom-code/CustomCodeBodyStart.astro';

const siteConfig = readData('siteConfig.json');
const pluginsConfig = readData('pluginsConfig.json', {});
const gscVerificationTag = (pluginsConfig as any)?.searchConsole?.verificationTag?.trim() || '';

const categoriesData = readData('categories.json', []);
const menuItems: any[] = readData('menu.json', { items: [] }).items || [];

const posts = await getCollection('blog');
const categoriesFromPosts = [...new Set(posts.map(p => p.data.category).filter(Boolean))];
const finalCategoriesData = Array.isArray(categoriesData) ? categoriesData : [];
const allCategories = normalizeCategories(finalCategoriesData.length > 0 ? finalCategoriesData : categoriesFromPosts);

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  image = '',
  type = 'website',
} = Astro.props;

const siteName = siteConfig.name || 'Varsha Editorial';
const formattedTitle = title === siteName ? title : `${title} — ${siteName}`;
const siteUrl = siteConfig.url || Astro.url.origin;
const socialImage = image?.startsWith('http') ? image : image ? new URL(image, siteUrl).toString() : '';
const defaultPalette = siteConfig.theme?.palette || 'tokyo-night';
const siteLogo = siteConfig.logo || '';
const siteSocial = siteConfig.social || {};
---

<!doctype html>
<html lang="pt-BR" data-palette={defaultPalette}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{formattedTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0c0c0b" />
    <link rel="canonical" href={Astro.url.href} />

    {/* Google Search Console */}
    {gscVerificationTag && (
      gscVerificationTag.startsWith('<')
        ? <Fragment set:html={gscVerificationTag} />
        : <meta name="google-site-verification" content={gscVerificationTag} />
    )}

    {/* Open Graph */}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={formattedTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    {socialImage && <meta property="og:image" content={socialImage} />}

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={formattedTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}

    <link rel="icon" href={siteConfig.favicon || '/assets/favicon.svg'} />
    <link rel="preload" href="/assets/jbm.woff2" as="font" type="font/woff2" crossorigin />

    {/* Palettes Init Script */}
    <script is:inline define:vars={{ defaultPalette }}>
      (function () {
        var saved = localStorage.getItem("varsha-palette");
        document.documentElement.setAttribute("data-palette", saved || defaultPalette);
      })();
    </script>

    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/a11y-tokens.css" />

    {/* Schema.org */}
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": siteName,
      "url": siteUrl,
      "description": description,
      "publisher": {
        "@type": "Organization",
        "name": siteConfig.author || siteName,
        "url": siteUrl
      }
    })} />

    <HeadPlugins />
  </head>
  <body>
    <CustomCodeBodyStart />

    {/* Site Header */}
    <header class="site-header">
      <nav class="nav" aria-label="Navegação principal">
        <a class="brand" href="/" aria-label={`${siteName} início`}>
          {siteLogo ? (
            <img src={siteLogo} alt={siteName} style="height: 28px; width: auto; object-fit: contain;" />
          ) : (
            <span class="brand-logo" aria-hidden="true"></span>
          )}
          <span style="font-weight: 700; letter-spacing: -0.02em;">{siteName}</span>
        </a>

        {/* Menu mobile */}
        <details class="nav-menu">
          <summary class="nav-menu-button" aria-label="Abrir menu de navegação">
            <span></span>
            <span></span>
            <span></span>
          </summary>
          <div class="nav-menu-panel">
            {menuItems.map(item => (
              <a href={item.href}>{item.label}</a>
            ))}
            <a href="/admin" target="_blank" style="color: var(--accent); font-weight: 600;">Painel CMS</a>
          </div>
        </details>

        {/* Desktop links */}
        <div class="nav-links">
          {menuItems.map(item => (
            <a href={item.href}>{item.label}</a>
          ))}
        </div>

        {/* Tools & CTA */}
        <div class="nav-tools">
          {siteSocial.github && (
            <a class="nav-icon-link" href={siteSocial.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.64 7.64 0 0 1 8 3.87c.68 0 1.36.09 2 .26 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
              </svg>
            </a>
          )}
          {siteSocial.instagram && (
            <a class="nav-icon-link" href={siteSocial.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <circle cx="12" cy="12" r="4"/>
                <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none"/>
              </svg>
            </a>
          )}
          <a class="nav-cta" href="/blog">Explorar Blog</a>
        </div>
      </nav>
    </header>

    {/* Main Page Slot */}
    <slot />

    {/* Editorial Footer */}
    <footer class="site-footer" style="border-top: 1px solid var(--line); padding: 56px 0 32px; margin-top: 80px; background: var(--bg-elevated);">
      <div class="content-shell" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 40px; margin-bottom: 40px; padding-bottom: 0;">
        <div>
          <h4 style="font-size: 1.15rem; font-weight: 700; margin: 0 0 12px; color: var(--ink); letter-spacing: -0.01em;">{siteName}</h4>
          <p style="font-size: 0.9rem; color: var(--muted); line-height: 1.6; margin: 0 0 16px;">
            {siteConfig.footer?.description || siteConfig.description}
          </p>
        </div>
        <div>
          <h5 style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 16px; color: var(--ink);">Navegação</h5>
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px;">
            {menuItems.map(item => (
              <li><a href={item.href} style="color: var(--muted); font-size: 0.9rem; text-decoration: none; transition: color 0.15s;">{item.label}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h5 style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 16px; color: var(--ink);">Editorias</h5>
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px;">
            {allCategories.slice(0, 5).map(cat => (
              <li><a href={`/categoria/${getCategorySlug(cat)}`} style="color: var(--muted); font-size: 0.9rem; text-decoration: none; transition: color 0.15s;">{getCategoryName(cat)}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h5 style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 16px; color: var(--ink);">Institucional</h5>
          <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px;">
            <li><a href="/sobre" style="color: var(--muted); font-size: 0.9rem; text-decoration: none;">Sobre a Redação</a></li>
            <li><a href="/contato" style="color: var(--muted); font-size: 0.9rem; text-decoration: none;">Fale Conosco</a></li>
            <li><a href="/privacidade" style="color: var(--muted); font-size: 0.9rem; text-decoration: none;">Privacidade</a></li>
            <li><a href="/termos" style="color: var(--muted); font-size: 0.9rem; text-decoration: none;">Termos de Uso</a></li>
          </ul>
        </div>
      </div>
      <div class="content-shell" style="border-top: 1px solid var(--line); padding-top: 24px; padding-bottom: 0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
        <p style="font-size: 0.85rem; color: var(--muted-2); margin: 0;">
          {siteConfig.footer?.copyright || `© ${new Date().getFullYear()} ${siteName}. Todos os direitos reservados.`}
        </p>
        
      </div>
    </footer>

    {/* Theme Switcher Button */}
    <div class="theme-hint" id="theme-hint" title="Pressione / ou t para trocar o tema visual">
      <span class="theme-hint-dot"></span>
      <span class="theme-hint-label" id="theme-hint-label">tema</span>
      <span class="theme-hint-key">[/]</span>
    </div>

    {/* Theme Overlay Dialog */}
    <div class="theme-overlay" id="theme-overlay" hidden>
      <div class="theme-overlay-panel" role="dialog" aria-label="Seletor de temas" aria-modal="true">
        <div class="theme-overlay-title">Paletas de Cores</div>
        <div class="theme-overlay-tabs"><span class="active">Estilos</span></div>
        <div class="theme-overlay-list" id="theme-overlay-list" role="listbox" aria-label="Temas">
          <div class="theme-sep"><span>Dark</span></div>
          <button type="button" role="option" data-value="tokyo-night">Tokyo Night</button>
          <button type="button" role="option" data-value="terminal">Terminal Black</button>
          <button type="button" role="option" data-value="catppuccin">Catppuccin Mocha</button>
          <button type="button" role="option" data-value="varsha">Varsha Classic</button>
          <button type="button" role="option" data-value="dracula">Dracula</button>
          <button type="button" role="option" data-value="nord">Nord</button>
          <button type="button" role="option" data-value="gruvbox">Gruvbox Dark</button>
          <button type="button" role="option" data-value="one-dark">One Dark</button>
          <button type="button" role="option" data-value="solarized">Solarized Dark</button>
          <div class="theme-sep"><span>Light</span></div>
          <button type="button" role="option" data-value="tokyo-night-day">Tokyo Night Day</button>
          <button type="button" role="option" data-value="catppuccin-latte">Catppuccin Latte</button>
          <button type="button" role="option" data-value="solarized-light">Solarized Light</button>
          <button type="button" role="option" data-value="retro">Retro Paper</button>
        </div>
        <div class="theme-overlay-foot">
          <span class="theme-help"><kbd>↑</kbd><kbd>↓</kbd> navegar <kbd>↵</kbd> escolher <kbd>esc</kbd> fechar</span>
          <button type="button" class="theme-close" id="theme-close-btn" aria-label="Fechar">fechar</button>
        </div>
      </div>
    </div>

    {/* Theme Switcher Script */}
    <script is:inline>
      (function () {
        var overlay = document.getElementById("theme-overlay");
        var hint = document.getElementById("theme-hint");
        var list = document.getElementById("theme-overlay-list");
        var hintLabel = document.getElementById("theme-hint-label");
        if (!overlay || !list) return;
        var options = Array.prototype.slice.call(list.querySelectorAll("[role='option']"));
        var media = window.matchMedia("(prefers-color-scheme: dark)");
        var saved = localStorage.getItem("varsha-palette") || "";
        var committed = saved || defaultPalette();

        function defaultPalette() {
          return media.matches ? "tokyo-night" : "tokyo-night-day";
        }

        function setPalette(value) {
          document.documentElement.setAttribute("data-palette", value || defaultPalette());
        }

        function updateUI(value) {
          var activeValue = value || defaultPalette();
          options.forEach(function (opt) {
            opt.setAttribute("aria-selected", String(opt.dataset.value === activeValue));
          });
          var active = options.find(function (opt) { return opt.dataset.value === activeValue; });
          if (hintLabel && active) hintLabel.textContent = active.textContent.trim();
        }

        function openOverlay() {
          overlay.hidden = false;
          document.body.style.overflow = "hidden";
          committed = localStorage.getItem("varsha-palette") || defaultPalette();
          updateUI(committed);
          var active = list.querySelector("[aria-selected='true']") || options[0];
          if (active) active.focus();
        }

        function closeOverlay() {
          overlay.hidden = true;
          document.body.style.overflow = "";
        }

        function toggleOverlay() {
          if (overlay.hidden) openOverlay();
          else closeOverlay();
        }

        function preview(index) {
          if (index < 0 || index >= options.length) return;
          setPalette(options[index].dataset.value);
          updateUI(options[index].dataset.value);
          options[index].focus();
        }

        function commit(value) {
          setPalette(value);
          localStorage.setItem("varsha-palette", value);
          updateUI(value);
          closeOverlay();
        }

        function revert() {
          setPalette(committed);
          updateUI(committed);
          closeOverlay();
        }

        if (hint) {
          hint.addEventListener("click", toggleOverlay);
        }

        options.forEach(function (opt, idx) {
          opt.addEventListener("click", function () { commit(opt.dataset.value); });
          opt.addEventListener("keydown", function (e) {
            if (e.key === "Enter" || e.key === " ") { e.preventDefault(); commit(opt.dataset.value); }
            else if (e.key === "ArrowDown") { e.preventDefault(); preview(idx + 1); }
            else if (e.key === "ArrowUp") { e.preventDefault(); preview(idx - 1); }
            else if (e.key === "Escape") { e.preventDefault(); revert(); }
          });
        });

        document.addEventListener("keydown", function (e) {
          var tag = (e.target && e.target.tagName) || "";
          if (tag === "INPUT" || tag === "TEXTAREA" || e.isComposing) return;
          if (e.key === "/" || e.key === "t") {
            e.preventDefault();
            toggleOverlay();
          } else if (e.key === "Escape" && !overlay.hidden) {
            e.preventDefault();
            revert();
          }
        });

        overlay.addEventListener("click", function (e) {
          if (e.target === overlay) revert();
        });

        var closeBtn = document.getElementById("theme-close-btn");
        if (closeBtn) closeBtn.addEventListener("click", revert);
        setPalette(saved);
        updateUI(saved);
      })();
    </script>

    <BodyEndPlugins />
  </body>
</html>
