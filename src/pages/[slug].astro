---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/varsha/BlogCard.astro';
import AuthorCard from '../components/varsha/AuthorCard.astro';
import PostSchemaPlugins from '../plugins/_slots/PostSchemaPlugins.astro';
import PostBottomPlugins from '../plugins/_slots/PostBottomPlugins.astro';
import PostAfterPlugins from '../plugins/_slots/PostAfterPlugins.astro';
import SocialShare from '../plugins/social-share/SocialShare.astro';
import { getCollection, render } from 'astro:content';
import { readData } from '../lib/readData';
import { getCategorySlug } from '../lib/categorySlug';

export async function getStaticPaths() {
  const RESERVED = new Set(['blog', 'sobre', 'contato', 'categoria', 'admin', 'login', 'registrar', 'politica-privacidade', 'termos', 'configuracoes']);
  const posts = await getCollection('blog');
  return posts
    .filter(p => !p.data.draft && !RESERVED.has(p.slug))
    .map(post => ({ params: { slug: post.slug }, props: post }));
}

const post = Astro.props;
const { Content, headings } = await render(post);
const sectionHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);

const authorsData = readData('authors.json', []);
const currentAuthor = authorsData.find((a: any) => a.id === post.data.author) || authorsData[0] || {
  name: 'Redação Varsha',
  role: 'Equipe Editorial',
  avatar: '/assets/author-yethikrishna.png',
  bio: 'Análises aprofundadas sobre tecnologia, engenharia de software e futuro digital.',
  instagram: 'https://instagram.com',
  email: 'redacao@varsha.blog'
};

const wordCount = post.body ? post.body.split(/\s+/).filter(Boolean).length : 500;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const pubDate = new Date(post.data.pubDate);
const dateFormatted = pubDate.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric'
});

const siteConfig = readData('siteConfig.json', {}) as any;
const postUrl = `${siteConfig.url || Astro.url.origin}/${post.slug}`;

// Related posts
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(p => p.slug !== post.slug && (!post.data.category || p.data.category === post.data.category))
  .slice(0, 3);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.heroImage}
  type="article"
>
  <PostSchemaPlugins
    title={post.data.title}
    description={post.data.description || ''}
    url={postUrl}
    image={post.data.heroImage}
    datePublished={pubDate.toISOString()}
    authorName={currentAuthor.name}
    category={post.data.category}
  />

  <main class="content-shell" style="padding-top: 32px;">
    
    {/* Breadcrumbs */}
    <nav style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: var(--muted); margin-bottom: 24px;">
      <a href="/" style="color: var(--muted); text-decoration: none;">Início</a>
      <span>/</span>
      <a href="/blog" style="color: var(--muted); text-decoration: none;">Blog</a>
      {post.data.category && (
        <>
          <span>/</span>
          <a href={`/categoria/${getCategorySlug(post.data.category)}`} style="color: var(--accent); text-decoration: none; font-weight: 600;">
            {post.data.category}
          </a>
        </>
      )}
    </nav>

    {/* Article Layout with Sidebar TOC */}
    <div class="article-layout section" style="padding: 0; display: grid; grid-template-columns: 1fr; gap: 48px;">
      
      <div style="display: grid; grid-template-columns: 1fr; gap: 48px;" class="article-grid">
        
        {/* Article Core */}
        <article class="article-shell" style="max-width: 100%;">
          
          <header class="article-header" style="margin-bottom: 36px;">
            <p class="post-meta" style="display: flex; align-items: center; gap: 10px; font-size: 0.88rem; color: var(--muted); margin-bottom: 16px;">
              <time datetime={pubDate.toISOString()}>{dateFormatted}</time>
              <span>·</span>
              <span>{readingTime} min de leitura</span>
            </p>

            <h1 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; line-height: 1.2; letter-spacing: -0.025em; color: var(--ink); margin: 0 0 16px;">
              {post.data.title}
            </h1>

            {post.data.description && (
              <p style="font-size: 1.15rem; color: var(--muted); line-height: 1.6; margin: 0 0 28px;">
                {post.data.description}
              </p>
            )}

            {/* Hero Image */}
            {post.data.heroImage && (
              <div style="border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--line); margin-bottom: 36px; background: var(--bg-elevated); aspect-ratio: 16 / 9;">
                <img
                  src={post.data.heroImage}
                  alt={post.data.title}
                  style="width: 100%; height: 100%; object-fit: cover;"
                />
              </div>
            )}
          </header>

          {/* Social Share Plugin */}
          <div style="margin-bottom: 32px; padding: 12px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);">
            <SocialShare title={post.data.title} url={postUrl} />
          </div>

          {/* Prose Content */}
          <div class="article-prose" style="font-size: 1.08rem; line-height: 1.8; color: var(--ink-soft);">
            <Content />
          </div>

          {/* Plugins: Bottom & After Content */}
          <PostBottomPlugins />

          {/* Author Card */}
          <div style="margin-top: 56px; padding-top: 40px; border-top: 1px solid var(--line);">
            <aside class="author-card" aria-label="Sobre o autor">
              <img
                class="author-photo"
                src={currentAuthor.avatar || '/assets/author-yethikrishna.png'}
                width="72"
                height="72"
                alt={currentAuthor.name}
                loading="lazy"
                decoding="async"
              />
              <div class="author-body">
                <p class="author-name">{currentAuthor.name}</p>
                <p class="author-role">{currentAuthor.role}</p>
                {currentAuthor.bio && (
                  <p style="font-size: 0.9rem; color: var(--muted); line-height: 1.5; margin: 6px 0 12px;">
                    {currentAuthor.bio}
                  </p>
                )}
                <div class="author-links">
                  {currentAuthor.instagram && (
                    <a href={currentAuthor.instagram} target="_blank" rel="noopener noreferrer">
                      <span>Instagram</span>
                    </a>
                  )}
                  {currentAuthor.email && (
                    <a href={`mailto:${currentAuthor.email}`}>
                      <span>Email</span>
                    </a>
                  )}
                </div>
              </div>
            </aside>
          </div>

          <PostAfterPlugins />
        </article>

      </div>

      {/* Related Posts */}
      {relatedPosts.length > 0 && (
        <section style="margin-top: 80px; padding-top: 48px; border-top: 1px solid var(--line);">
          <h3 style="font-size: 1.5rem; font-weight: 800; color: var(--ink); margin: 0 0 24px; letter-spacing: -0.02em;">
            Artigos Relacionados
          </h3>
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px;">
            {relatedPosts.map(p => (
              <BlogCard post={p} />
            ))}
          </div>
        </section>
      )}

    </div>
  </main>
</BaseLayout>

<style>
  .article-prose :global(h2) {
    font-size: 1.75rem;
    font-weight: 800;
    margin: 48px 0 16px;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .article-prose :global(h3) {
    font-size: 1.35rem;
    font-weight: 700;
    margin: 36px 0 14px;
    color: var(--ink);
    letter-spacing: -0.015em;
  }

  .article-prose :global(p) {
    margin: 0 0 24px;
  }

  .article-prose :global(ul),
  .article-prose :global(ol) {
    margin: 0 0 24px 20px;
    padding-left: 10px;
  }

  .article-prose :global(li) {
    margin-bottom: 8px;
  }

  .article-prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding: 12px 20px;
    margin: 32px 0;
    background: var(--bg-elevated);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-style: italic;
    color: var(--ink);
  }

  .article-prose :global(img) {
    max-width: 100%;
    border-radius: var(--radius-md);
    border: 1px solid var(--line);
    margin: 32px 0;
  }

  .article-prose :global(code) {
    font-family: var(--mono);
    font-size: 0.9em;
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    padding: 2px 6px;
    border-radius: 4px;
    color: var(--accent);
  }

  .article-prose :global(pre) {
    background: var(--term-bg, #0c0c0b);
    color: var(--term-text, #dedad0);
    padding: 20px;
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin: 32px 0;
    border: 1px solid var(--line);
  }

  .article-prose :global(pre code) {
    background: transparent;
    border: none;
    padding: 0;
    color: inherit;
  }
</style>
