---
import { getCategorySlug } from '../../lib/categorySlug';
import { postUrl } from '../../lib/postUrl';

interface Props {
  post: {
    slug: string;
    data: {
      title: string;
      description?: string;
      pubDate: Date | string;
      heroImage?: string;
      category?: string;
      author?: string;
    };
    body?: string;
  };
  featured?: boolean;
}

const { post, featured = false } = Astro.props;

const url = postUrl(post.slug);
const pubDate = new Date(post.data.pubDate);
const dateFormatted = pubDate.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'short',
  year: 'numeric'
});

const wordCount = post.body ? post.body.split(/\s+/).filter(Boolean).length : 600;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
const categorySlug = post.data.category ? getCategorySlug(post.data.category) : '';
---

<article class={`varsha-post-card ${featured ? 'varsha-post-card--featured' : ''}`}>
  {post.data.heroImage && (
    <a href={url} class="varsha-post-card__image-link" tabindex="-1" aria-hidden="true">
      <img
        src={post.data.heroImage}
        alt={post.data.title}
        loading="lazy"
        class="varsha-post-card__image"
      />
    </a>
  )}

  <div class="varsha-post-card__content">
    <div class="varsha-post-card__meta">
      {post.data.category && (
        <a href={`/categoria/${categorySlug}`} class="tag-pill">
          {post.data.category}
        </a>
      )}
      <time datetime={pubDate.toISOString()} class="varsha-post-card__date">
        {dateFormatted}
      </time>
      <span class="varsha-post-card__sep">·</span>
      <span class="varsha-post-card__readtime">{readingTime} min de leitura</span>
    </div>

    <h2 class="varsha-post-card__title">
      <a href={url} class="varsha-post-card__link">
        {post.data.title}
      </a>
    </h2>

    {post.data.description && (
      <p class="varsha-post-card__desc">
        {post.data.description}
      </p>
    )}

    <div class="varsha-post-card__footer">
      <a href={url} class="varsha-post-card__cta">
        <span>Ler artigo</span>
        <span class="varsha-post-card__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</article>

<style>
  .varsha-post-card {
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg, 8px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .varsha-post-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: 0 10px 24px -10px rgba(0, 0, 0, 0.2);
  }

  .varsha-post-card--featured {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .varsha-post-card--featured {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .varsha-post-card__image-link {
    display: block;
    overflow: hidden;
    background: var(--bg);
    aspect-ratio: 16 / 9;
  }

  .varsha-post-card--featured .varsha-post-card__image-link {
    height: 100%;
    min-height: 280px;
    aspect-ratio: auto;
  }

  .varsha-post-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .varsha-post-card:hover .varsha-post-card__image {
    transform: scale(1.03);
  }

  .varsha-post-card__content {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .varsha-post-card__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: var(--muted);
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .varsha-post-card__sep {
    color: var(--line-strong);
  }

  .varsha-post-card__title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.35;
    margin: 0 0 10px;
    color: var(--ink);
    letter-spacing: -0.015em;
  }

  .varsha-post-card--featured .varsha-post-card__title {
    font-size: 1.6rem;
  }

  .varsha-post-card__link {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .varsha-post-card__link:hover {
    color: var(--accent);
  }

  .varsha-post-card__desc {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0 0 20px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
  }

  .varsha-post-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    margin-top: auto;
  }

  .varsha-post-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
    transition: gap 0.2s ease;
  }

  .varsha-post-card:hover .varsha-post-card__cta {
    gap: 10px;
  }

  .varsha-post-card__arrow {
    transition: transform 0.2s ease;
  }

  .varsha-post-card:hover .varsha-post-card__arrow {
    transform: translateX(2px);
  }
</style>
